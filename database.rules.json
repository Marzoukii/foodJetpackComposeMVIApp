{
  "rules": {
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt"],
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'RECEIVED') || (data.exists() && root.child('admins').child(auth.uid).val() === true))",
        "status": {
          ".validate": "newData.val() === 'RECEIVED' || newData.val() === 'PREPARING' || newData.val() === 'ON_THE_WAY' || newData.val() === 'DELIVERED'"
        }
      }
    },
    "userOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$orderId": { ".write": "auth != null && auth.uid === $uid" }
      }
    }
  }
}
