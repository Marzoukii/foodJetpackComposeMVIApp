{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && auth.token.email_verified === true && auth.token.email === 'chadimarzouki@gmail.com'))",
        ".validate": "newData.val() === true"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.provider !== 'anonymous'",
        ".validate": "newData.child('email').val() === auth.token.email",
        "email": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },
    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt"],
      "$orderId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'RECEIVED' && (newData.child('orderType').val() === 'DINE_IN' || auth.provider !== 'anonymous')) || (data.exists() && root.child('admins').child(auth.uid).val() === true))",
        "status": {
          ".validate": "newData.val() === 'RECEIVED' || newData.val() === 'PREPARING' || newData.val() === 'ON_THE_WAY' || newData.val() === 'DELIVERED'"
        },
        "orderType": {
          ".validate": "newData.val() === 'DELIVERY' || newData.val() === 'DINE_IN'"
        },
        "tableNumber": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        }
      }
    },
    "userOrders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$orderId": { ".write": "auth != null && auth.uid === $uid" }
      }
    }
  }
}
